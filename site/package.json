{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start:secret": "SECRET_MODE=true docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "format": "prettier --write \"**/*.{mdx,jsx,tsx,ts,js,css}\"",
    "pokedex": "tsx scripts/pokedex.mts",
    "postinstall": "npx playwright install chromium",
    "playwright": "tsx scripts/playwright.mts",
    "playwright:ui": "playwright test --ui",
    "playwright:ui:secret": "SECRET_MODE=true playwright test --ui",
    "playwright:update": "tsx scripts/playwright.mts --update-snapshots",
    "vitest": "vitest run",
    "overlay-server": "node overlay-server.js",
    "sprite-colors": "tsx scripts/sprite-colors.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/preset-classic": "3.10.0",
    "@mdx-js/react": "^3.0.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.0.0",
    "framer-motion": "^12.38.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.0",
    "@docusaurus/tsconfig": "3.10.0",
    "@docusaurus/types": "3.10.0",
    "@playwright/test": "^1.50.0",
    "@prettier/plugin-xml": "^3.4.2",
    "gh-pages": "^6.3.0",
    "jimp": "^1.6.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.0.0",
    "typescript": "~5.6.2",
    "vitest": "^3.0.0",
    "ws": "^8.20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5"
  }
}
